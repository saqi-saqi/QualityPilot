# ─── QualityPilot configuration ─────────────────────────────────────────
# Copy to .env and fill in what you need. Everything is optional —
# defaults give you a local, open dashboard.

# REQUIRED on any publicly reachable deployment. All API routes (except
# /health) will require this key; the dashboard will prompt for it.
SQA_API_TOKEN=

# Dashboard port (default 8080)
SQA_DASHBOARD_PORT=8080

# Network interface the dashboard binds to. Default 127.0.0.1 — set 0.0.0.0
# only behind a TLS-terminating reverse proxy. (SQA_BIND_HOST still works
# as a legacy alias.)
SQA_BIND=127.0.0.1

# Allow scanning localhost/private-network targets (dev only — never on a VPS)
SQA_ALLOW_PRIVATE=false
# Developer-only switch to allow scanning private hostnames (e.g. localhost, internal hosts).
# Off by default. It's fine on your own machine, but NEVER turn it on for a public service!
ALLOW_PRIVATE_HOSTS=false

# ─── Browser matrix ──────────────────────────────────────────────────
# Comma-separated browsers used when a plan/run doesn't specify one.
SQA_DEFAULT_BROWSERS=chromium
# ONLY for container hosts that cannot run the Chromium sandbox — keep the
# sandbox enabled (default) and use CAP_SYS_ADMIN in docker-compose instead.
SQA_CHROMIUM_NO_SANDBOX=false

# ─── AI test planning (optional but recommended) ─────────────────────
# Provider: glm | openai | mock (omit = auto-detect).
# glm: free Z.ai key — create ~/.z-ai-config with {"baseUrl": "...", "apiKey": "..."}
# openai: any OpenAI-compatible endpoint via the three OPENAI_* vars below.
# mock: deterministic stub — CI/tests only, no network.
SQA_LLM_PROVIDER=
OPENAI_API_KEY=sk-your-openai-compatible-key
OPENAI_BASE_URL=
OPENAI_MODEL=
# FreeLLMAPI example:
# OPENAI_BASE_URL=http://127.0.0.1:3000/v1
# OPENAI_API_KEY=sk-your-openai-compatible-key
 #OPENAI_MODEL=auto
# No LLM = rules-based checks only.

# ─── Issue tracker (auto-file findings as tickets) ───────────────────
# none | github | jira | console
SQA_ISSUE_TRACKER=none
# GitHub (SQA_GITHUB_TOKEN is the documented token name):
SQA_GITHUB_REPO=
SQA_GITHUB_TOKEN=
# Jira:
SQA_JIRA_BASE_URL=
SQA_JIRA_EMAIL=
SQA_JIRA_API_TOKEN=
SQA_JIRA_PROJECT_KEY=
# Public dashboard URL referenced when filing issues / in webhook payloads
# (links the filed ticket back to the run report).
SQA_DASHBOARD_URL=
# Minimum severity to file (medium | high | critical). Default medium.
SQA_TRACKER_MIN_SEVERITY=medium
# Log what would be filed without calling the tracker API.
SQA_TRACKER_DRY_RUN=false

# ─── Test result publishing (optional) ───────────────────────────────
# publisher: testrail — push run results to TestRail
SQA_TESTRAIL_URL=
SQA_TESTRAIL_EMAIL=
SQA_TESTRAIL_API_KEY=
SQA_TESTRAIL_PROJECT_ID=
# publisher: xray — push run results to Xray
SQA_XRAY_CLIENT_ID=
SQA_XRAY_CLIENT_SECRET=
SQA_XRAY_BASE_URL=

# ─── Test data (e2e flows) ───────────────────────────────────────────
# Any env var prefixed SQA_TD_ is exposed to e2e flows as ${NAME}
# (prefix stripped, e.g. SQA_TD_USERNAME → ${USERNAME}). Prefer these over
# data/testdata.json for credentials — they never touch the disk.
SQA_TD_USERNAME=
SQA_TD_PASSWORD=

# ─── Webhook notifications (Discord/Slack/generic) ───────────────────
# Receives POST {runId, url, score, status, findings[], reportUrl}
SQA_WEBHOOK_URL=
# Public URL of this dashboard (used in the reportUrl of webhook payloads)
SQA_PUBLIC_URL=

# ─── Scheduler (monitoring loop) ─────────────────────────────────────
# false = monitors never trigger automatically
SQA_SCHEDULER_ENABLED=true
# How often the scheduler checks for due monitors (ms). Default 60000.
SQA_SCHEDULER_INTERVAL_MS=60000

# ─── Limits / retention ──────────────────────────────────────────────
MAX_CONCURRENT_RUNS=2
SQA_MAX_RUN_MS=600000
SQA_MAX_PAGES_HARD=100
SQA_CLEANUP_MS=86400000
