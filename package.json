    "mcp": "node src/mcp/stdio.js"
  },
  "dependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.5",
    "dotenv": "^18.0.10",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^8.0.0",
    "playwright": "1.63.0",
    "undici": "^8.12.4",
    "yaml": "2.9.1",
    "zod": "^4.6.7"
  },
  "optionalDependencies": {
    "z-ai-web-dev-sdk": "^0.0.18"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0"
