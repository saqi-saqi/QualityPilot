{
  "name": "testigator",
  "version": "0.5.0",
  "type": "module",
  "description": "Testigator (saqi-saqi/Testigator) — Self-hosted, deterministic-first Node.js + Playwright QA quality-gate agent & MCP server with SQLite TestOps state",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saqi-saqi/Testigator.git"
  },
  "homepage": "https://github.com/saqi-saqi/Testigator#readme",
  "bugs": {
    "url": "https://github.com/saqi-saqi/Testigator/issues"
  },
  "keywords": [
    "testing",
    "qa",
    "e2e",
    "accessibility",
    "wcag",
    "a11y",
    "security",
    "performance",
    "playwright",
    "mcp",
    "model-context-protocol",
    "ci",
    "sarif",
    "junit",
    "autonomous-agents",
    "web-testing",
    "api-testing",
    "testigator",
    "quality-gate",
    "qa-agent",
    "self-hosted",
    "sqlite",
    "visual-regression",
    "api-contract",
    "security-testing",
    "fuzzing",
    "ollama"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "bin": {
    "testigator": "src/cli/testigator.js",
    "testigator-mcp": "src/mcp/stdio.js",
    "qualitypilot": "src/cli/qualitypilot.js",
    "qualitypilot-mcp": "src/mcp/stdio.js"
  },
  "files": [
    "src",
    "dashboard",
    "scripts/migrate-json-to-sqlite.js",
    ".env.example"
  ],
  "scripts": {
    "test": "node scripts/run-tests.mjs",
    "check": "node src/cli/check.js",
